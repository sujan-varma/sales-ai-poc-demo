# =====================================================================================================
# Sales AI web app (Next.js) — environment variables
# Full reference: ../ENVIRONMENT.md
#
# Local development: copy to frontend/.env.local (git-ignored).
# Docker / Kubernetes: set these as container environment variables at RUNTIME — no rebuild needed.
# There are no secrets in the frontend.
# =====================================================================================================

# REQUIRED (runtime). The backend's URL as the user's BROWSER reaches it — a public URL in production,
# never an internal service name. Served to the browser by GET /runtime-config.
#   local:       http://localhost:8000
#   production:  https://sales-ai-api.example.com
API_URL=http://localhost:8000

# Port and interface of the Next.js server (the Docker image uses 3000 / 0.0.0.0).
PORT=3000
HOSTNAME=0.0.0.0

# Opt out of Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1

# BUILD-TIME only, optional. Backend URL used by `npm run export:html` (single-file export, fetches the data
# at build time) and as the fallback if /runtime-config is unreachable. Not needed for the Docker image.
# NEXT_PUBLIC_API_URL=http://localhost:8000
