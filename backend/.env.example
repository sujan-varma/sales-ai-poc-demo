# =====================================================================================================
# Sales AI backend (FastAPI) — environment variables
# Full reference: ../ENVIRONMENT.md
#
# Local development: copy to backend/.env (git-ignored). Relative paths resolve from the backend/ folder.
# Docker / Kubernetes: set these as container environment variables. The image presets EXCEL_PATH,
# TOKENS_PATH and APP_STATIC_DIR, so only the SECRETS and CORS_ORIGINS are usually needed.
# =====================================================================================================

# ---------------------------------------------------------------- secrets (store in a secret manager)

# REQUIRED. Shared secret for the protected endpoints, sent as the "X-API-Key" header:
#   POST /api/sales/reload · POST /api/notifications/send · GET /api/notifications/tokens
# Empty = those endpoints answer 503 "API_KEY is not configured".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Optional. Expo access token, only if "Enhanced push security" is on for the Expo project
# (expo.dev -> Account settings -> Access tokens). Leave empty otherwise.
EXPO_ACCESS_TOKEN=

# Optional. Web Push (VAPID) private key as PEM text (\n for newlines), for the mobile app's push notifications.
# Empty = generated once and kept in VAPID_PATH. Changing it makes every phone turn push on again.
VAPID_PRIVATE_KEY=
# Contact the browser push services can reach (mailto: or https:)
VAPID_SUBJECT=mailto:sales-ai@example.com

# ---------------------------------------------------------------- network

# Browser origins allowed to call the API (CORS), comma-separated, or * for any.
# Production: the web app's exact public origin(s), e.g. https://sales-ai.example.com
# (Native mobile apps are not affected by CORS.)
CORS_ORIGINS=*

# Expo push endpoint. Only change for a proxy / test double.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ---------------------------------------------------------------- data and state

# The Excel workbook the API serves (loaded once at startup, ~10–30 s).
# Docker image default: /app/data/Master data_Sales GenAI.xlsx
EXCEL_PATH=data/Master data_Sales GenAI.xlsx

# Registered device push tokens (JSON file, written by the API). Must be on persistent storage.
# Docker image default: /app/state/tokens.json  (mount a volume at /app/state)
TOKENS_PATH=data/tokens.json

# Assigned actions, status updates from the app and the notification inbox (JSON, written by the API).
# Must be on persistent storage. Docker image default: /app/state/tracker.json
TRACKER_PATH=data/tracker.json

# Generated VAPID key (used only when VAPID_PRIVATE_KEY is empty). Docker image default: /app/state/vapid.pem
VAPID_PATH=data/vapid.pem

# Folder of the mobile web app, served at /app/ (skipped if the folder doesn't exist).
# Docker image default: /app/mobile-app
APP_STATIC_DIR=../mobile/app

# ---------------------------------------------------------------- behaviour

# After a successful POST /api/sales/reload, push "Sales data updated" to every registered device.
NOTIFY_ON_RELOAD=true

# Due-today / overdue reminders for assigned actions, every N minutes. 0 = off (POST /api/tracker/reminders/run instead).
REMINDER_INTERVAL_MINUTES=0

# Mobile app: sales officer shown when the app doesn't pass ?so= (an ID from GET /api/app/sales-officers).
DEFAULT_SALES_OFFICER=SO018

# Mobile app: the app's "today" (YYYY-MM-DD). The workbook's actuals run to 20 Sep 2026.
APP_TODAY=2026-09-21
