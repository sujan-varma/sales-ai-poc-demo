# Copy to .env and fill in. Paths are relative to the backend/ folder.

# Excel workbook served by the API
EXCEL_PATH=data/Master data_Sales GenAI.xlsx

# Registered device push tokens (created automatically)
TOKENS_PATH=data/tokens.json

# Required for POST /api/sales/reload and POST /api/notifications/send (send it as the X-API-Key header).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Expo Push API. Only needed if "Enhanced push security" is enabled for your Expo project
# (expo.dev -> Account settings -> Access tokens).
EXPO_ACCESS_TOKEN=

# Allowed browser origins, comma-separated, or * for any (mobile apps are not affected by CORS)
CORS_ORIGINS=*

# Send a "Sales data updated" push to all devices after a successful reload
NOTIFY_ON_RELOAD=true

# Mobile app (GET /api/app/bootstrap)
DEFAULT_SALES_OFFICER=SO018
# The app's "today" (Excel actuals run to 20 Sep 2026)
APP_TODAY=2026-09-21
# Folder served at /app (the mobile app's web build)
APP_STATIC_DIR=../mobile/app
