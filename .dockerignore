# Build context for backend/Dockerfile (docker build -f backend/Dockerfile .). The frontend has its own
# frontend/.dockerignore because it builds from ./frontend.
.git
frontend
**/node_modules
.next
out
*.tsbuildinfo
dist

# python
backend/.venv
**/__pycache__
**/*.pyc

# secrets / runtime state — never bake into images
**/.env
**/.env.*
!**/.env.example
backend/data/tokens.json
deploy.env

# not needed to build or run the backend
.impeccable
.claude
archive
docs
mobile/mockups
**/.DS_Store
DEPLOYMENT.md
docker-compose.yml
