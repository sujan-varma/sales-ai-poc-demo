# Copy to deploy.env (git-ignored) and fill in. Used by: docker compose --env-file deploy.env up -d

# Required. Protects POST /api/sales/reload and the push-notification endpoints (X-API-Key header).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Backend URL as the user's browser reaches it (public URL in production, e.g. https://sales-ai-api.example.com)
API_URL=http://localhost:8000

# Browser origins allowed to call the backend, comma-separated (the frontend's public URL in production)
CORS_ORIGINS=http://localhost:3000

# Optional: Expo access token, only if "enhanced push security" is on for the Expo project
EXPO_ACCESS_TOKEN=

# Optional
BACKEND_PORT=8000
FRONTEND_PORT=3000
NOTIFY_ON_RELOAD=true
DEFAULT_SALES_OFFICER=SO018
APP_TODAY=2026-09-21

# Optional: image naming for pushing to a registry, e.g. REGISTRY=registry.example.com/sales-ai/  TAG=1.0.0
REGISTRY=
TAG=latest
