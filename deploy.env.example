# =====================================================================================================
# Docker Compose deployment — copy to deploy.env (git-ignored), fill in, then:
#   docker compose --env-file deploy.env up -d --build
# Full reference (every variable, per-environment values): ENVIRONMENT.md
# =====================================================================================================

# ---------------------------------------------------------------- secrets

# REQUIRED. Backend API key for reload / push endpoints (X-API-Key header).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Optional. Expo access token (only with Expo "Enhanced push security").
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------- URLs (must match each other)

# Backend URL as the user's BROWSER reaches it  → frontend container (API_URL)
API_URL=http://localhost:8000

# Web app origin(s) allowed to call the backend → backend container (CORS_ORIGINS)
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- host ports

BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---------------------------------------------------------------- behaviour (optional)

NOTIFY_ON_RELOAD=true

# Web Push for the mobile app. Empty key = generated once into /app/state/vapid.pem (keep that volume).
# Set it (PEM, \n for newlines) to keep one key everywhere; changing it makes phones turn push on again.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sales-ai@example.com
# Due-today / overdue reminders for assigned actions every N minutes (0 = off)
REMINDER_INTERVAL_MINUTES=0
DEFAULT_SALES_OFFICER=SO018
APP_TODAY=2026-09-21

# ---------------------------------------------------------------- image naming (optional)

# Registry prefix with trailing slash, e.g. registry.example.com/sales-ai/   and the image tag
REGISTRY=
TAG=latest
